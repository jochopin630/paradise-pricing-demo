                    onMouseLeave={() => setTooltip(null)}
                  >
                    
                    {/* SURGE 팝업 배지 (클릭 시 상세 모달 오픈) */}
                    <div onClick={() => setActiveModal('recommendation')} className="absolute top-10 right-40 bg-slate-900/95 border border-red-500/80 rounded-xl p-3 shadow-2xl z-30 text-xs backdrop-blur-md cursor-pointer hover:border-red-400 transition-all animate-pulse">
                      <div className="flex items-center justify-between gap-4 mb-1">
                        <span className="font-bold text-white text-xs">10/09 (금)</span>
                        <span className="bg-red-500 text-white font-black px-2 py-0.5 rounded text-[10px]">SURGE</span>
                      </div>
                      <div className="text-cyan-300 font-bold text-xs">Deluxe Room</div>
                      <div className="text-emerald-400 font-bold text-xs">AI 추천가 945,000원 <span className="text-amber-400">(+15.2%)</span></div>
                    </div>

                    {/* 상단 날짜 가이드 */}
                    <div className="pl-20 flex justify-between pb-3 border-b border-slate-800 text-xs text-slate-300 font-bold pr-2 bg-slate-900/40 px-3 py-2 rounded-lg">
                      <span className="text-slate-400 font-medium">📅 타임라인</span>
                      <div className="flex gap-5">
                        {dates.map((d, i) => (
                          <div key={i} className="flex flex-col items-center">
                            <span className={i === 8 ? 'text-amber-400 font-black bg-amber-500/20 px-1.5 py-0.5 rounded border border-amber-500/40' : 'text-slate-300'}>{d.day}</span>
                            <span className="text-[10px] text-slate-400 font-medium">{d.week}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div className="flex-1 flex gap-3 relative h-full mt-2 items-center">
                      {/* 좌측 Y축 가격 눈금 */}
                      <div className="w-20 flex flex-col justify-between text-xs text-slate-300 font-mono text-right pr-3 border-r border-slate-800 h-full py-1 font-semibold">
                        <span className="font-bold text-amber-400">1,600,000원</span>
                        <span>1,300,000원</span>
                        <span>1,000,000원</span>
                        <span>700,000원</span>
                        <span className="font-bold text-emerald-400">400,000원</span>
                      </div>

                      {/* SVG 다중 라인 그래프 */}
                      <div className="flex-1 relative h-full flex items-center">
                        <div className="absolute inset-0 flex flex-col justify-between opacity-20 pointer-events-none">
                          {[1,2,3,4,5].map((_, i) => <div key={i} className="w-full border-b border-slate-700"></div>)}
                        </div>
                        <svg viewBox="0 0 1000 200" preserveAspectRatio="none" className="w-full h-48 overflow-visible">
                          {roomFilters.classicSuite && <polyline fill="none" stroke="#ffffff" strokeWidth="2" points="0,50 100,45 200,60 300,40 400,70 500,55 600,45 700,30 800,25 900,40 1000,35" className="opacity-95 hover:opacity-100 cursor-pointer"/>}
                          {roomFilters.junior && <polyline fill="none" stroke="#f87171" strokeWidth="1.8" points="0,80 100,75 200,90 300,70 400,100 500,85 600,75 700,50 800,45 900,65 1000,60" className="opacity-95 hover:opacity-100 cursor-pointer"/>}
                          {roomFilters.classicRoom && <polyline fill="none" stroke="#38bdf8" strokeWidth="1.8" points="0,110 100,105 200,120 300,100 400,130 500,115 600,105 700,80 800,75 900,95 1000,90" className="opacity-95 hover:opacity-100 cursor-pointer"/>}
                          {roomFilters.deluxe && <polyline fill="none" stroke="#22d3ee" strokeWidth="2" points="0,140 100,135 200,150 300,130 400,160 500,145 600,135 700,20 800,105 900,125 1000,120" className="opacity-100 cursor-pointer"/>}
                        </svg>
                      </div>
                    </div>
                  </div>
                  <div className="mt-3.5 flex justify-between items-center text-xs text-slate-400">
                    <span>* 선을 클릭하거나 마우스를 올리면 날짜별 상세 추천 요금을 조회할 수 있습니다.</span>
                    <span className="font-semibold text-slate-300">최종 동기화: {lastUpdated}</span>
                  </div>
                </div>

                {/* 우측: AI 추천 가격 카드 */}
                <div className="col-span-4 bg-slate-900 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between shadow-xl relative">
                  <div>
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="font-bold text-white text-sm flex items-center gap-2">
                        <Sparkles size={16} className="text-amber-400"/> AI 추천 가격
                      </h3>
                      <span className="text-xs text-slate-400 font-medium">오늘의 최적화 제안</span>
                    </div>

                    {/* Deluxe Room 10/09 Surge 강조 박스 */}
                    <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 mb-4 relative overflow-hidden shadow-inner">
                      <div className="flex justify-between items-start mb-1">
                        <div>
                          <div className="text-xs text-slate-400 font-medium">Deluxe Room (10/09)</div>
                          <div className="text-xl font-black text-white mt-1">945,000원 <span className="text-amber-400 text-sm font-bold">+15.2%</span></div>
                        </div>
                        <span className="bg-red-500 text-white font-black px-2.5 py-1 rounded-lg text-xs animate-pulse">SURGE</span>
                      </div>
                    </div>

                    {/* 추천 신뢰도 바 */}
                    <div className="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 mb-4 flex items-center justify-between">
                      <div>
                        <div className="text-xs text-slate-400 font-semibold">추천 신뢰도</div>
                        <div className="text-sm font-bold text-white mt-0.5">매우 높음 (Optimal)</div>
                      </div>
                      <div className="w-11 h-11 rounded-full border-2 border-emerald-400 flex items-center justify-center text-emerald-400 font-bold text-sm bg-emerald-950/40">
                        92%
                      </div>
                    </div>

                    {/* 추천 근거 리스트 */}
                    <div className="space-y-2.5 text-xs mb-4">
                      <div className="font-bold text-slate-200 mb-1 text-sm">추천 근거</div>
                      <div className="flex justify-between items-center text-slate-300"><span>✔ 예약 Pickup 상승</span><span className="font-bold text-emerald-400">+23%</span></div>
                      <div className="flex justify-between items-center text-slate-300"><span>✔ 예상 수요 증가</span><span className="font-bold text-emerald-400">HIGH</span></div>
                      <div className="flex justify-between items-center text-slate-300"><span>✔ 경쟁호텔 가격 상승</span><span className="font-bold text-emerald-400">+5%</span></div>
                      <div className="flex justify-between items-center text-slate-300"><span>✔ 객실 가동률</span><span className="font-bold text-emerald-400">82%</span></div>
                      <div className="flex justify-between items-center text-slate-300"><span>✔ 이벤트 영향</span><span className="font-bold text-emerald-400">+12%</span></div>
                    </div>

                    <div className="bg-amber-950/40 border border-amber-900/60 p-3 rounded-xl text-xs text-amber-200 leading-relaxed mb-4">
                      10/09은 고수요가 예상되어 Deluxe Room 가격을 15% 상향할 것을 권고합니다.
                    </div>
                  </div>

                  <button onClick={() => setActiveModal('recommendation')} className="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl text-xs sm:text-sm shadow-lg transition-all flex items-center justify-center gap-2">
                    추천안 검토 및 승인하기 →
                  </button>
                </div>

              </div>

              {/* 하단 영역 그리드: 객실 타입별 가격 상세 테이블 & What-if 시뮬레이션 */}
              <div className="grid grid-cols-12 gap-5">
                
                {/* 좌측 하단: 객실 타입별 가격 상세 테이블 */}
                <div className="col-span-8 bg-slate-900 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col justify-between">
                  <div>
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="font-bold text-white text-sm">객실 타입별 가격 상세</h3>
                      <span className="text-xs text-slate-400">실시간 연동 완료</span>
                    </div>
                    <div className="overflow-x-auto">
                      <table className="w-full text-left text-xs sm:text-sm">
                        <thead>
                          <tr className="border-b border-slate-800 text-slate-400 text-xs font-semibold">
                            <th className="pb-3">객실 타입</th>
                            <th className="pb-3">기준가 (현재)</th>
                            <th className="pb-3">AI 추천가</th>
                            <th className="pb-3">최종 적용가</th>
                            <th className="pb-3">변동률</th>
                            <th className="pb-3">예약률 (OCC)</th>
                            <th className="pb-3">예상 매출</th>
                            <th className="pb-3 text-right">상태</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-slate-800/60">
                          {roomTableData.map((room, idx) => (
                            <tr key={idx} className="hover:bg-slate-800/40 transition-colors font-medium">
                              <td className="py-3.5 text-white flex items-center gap-2.5">
                                <span className="w-3 h-3 rounded-full shrink-0" style={{ backgroundColor: room.color }}></span>
                                {room.type}
                              </td>
                              <td className="py-3.5 text-slate-400">{room.base.toLocaleString()}원</td>
                              <td className="py-3.5 text-amber-400 font-bold">{room.ai.toLocaleString()}원</td>
                              <td className="py-3.5 text-white font-bold">{room.final.toLocaleString()}원</td>
                              <td className="py-3.5 text-emerald-400 font-bold">{room.change}</td>
                              <td className="py-3.5 text-slate-300">{room.occ}</td>
                              <td className="py-3.5 text-emerald-400 font-semibold">{room.revenue}</td>
                              <td className="py-3.5 text-right">
                                <button onClick={() => showToast(`[${room.type}] 가격이 PMS 채널에 동기화되었습니다.`)} className="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-2.5 py-1 rounded-lg text-xs shadow-sm transition-all">
                                  적용
                                </button>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

                {/* 우측 하단: What-if 시뮬레이션 */}
                <div className="col-span-4 bg-slate-900 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between shadow-xl">
                  <div>
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="font-bold text-white text-sm flex items-center gap-2">
                        <Cpu size={16} className="text-amber-400"/> What-if 시뮬레이션
                      </h3>
                      <span className="text-xs text-blue-400 font-semibold cursor-pointer hover:underline" onClick={() => { setWhatIfSlider(15); showToast('시뮬레이션 값이 초기화되었습니다.'); }}>초기화</span>
                    </div>
                    
                    <div className="text-xs text-slate-300 mb-2 font-medium">가격 조정률 슬라이더</div>
                    <div className="flex items-center gap-4 mb-5">
                      <input 
                        type="range" 
                        min="-20" 
                        max="30" 
                        value={whatIfSlider} 
                        onChange={(e) => setWhatIfSlider(Number(e.target.value))} 
                        className="w-full accent-amber-500 h-2 bg-slate-800 rounded-lg cursor-pointer" 
                      />
                      <span className="font-black text-amber-400 text-sm w-12 text-right">{whatIfSlider >= 0 ? `+${whatIfSlider}%` : `${whatIfSlider}%`}</span>
                    </div>

                    <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 mb-4 space-y-2.5 shadow-inner">
                      <div className="text-xs text-slate-400 font-bold uppercase tracking-wider">실시간 연산 시뮬레이션 결과</div>
                      <div className="flex justify-between items-center text-xs sm:text-sm"><span className="text-slate-400">예상 매출</span><span className="font-bold text-emerald-400">{Math.round(simulatedRevenue/1000000)}M <span className="text-[11px] text-emerald-400 font-semibold">(+ 연동중)</span></span></div>
                      <div className="flex justify-between items-center text-xs sm:text-sm"><span className="text-slate-400">평균 ADR</span><span className="font-bold text-white">{simulatedAdr.toLocaleString()}원</span></div>
                      <div className="flex justify-between items-center text-xs sm:text-sm"><span className="text-slate-400">예상 OCC</span><span className="font-bold text-purple-400">{simulatedOcc}%</span></div>
                      <div className="flex justify-between items-center text-xs sm:text-sm"><span className="text-slate-400">RevPAR</span><span className="font-bold text-emerald-400">{simulatedRevpar.toLocaleString()}원</span></div>
                    </div>

                    {/* 적용 프로세스 스텝 바 */}
                    <div className="text-xs text-slate-400 font-bold mb-2">적용 프로세스 단계</div>
                    <div className="grid grid-cols-4 gap-1.5 text-center text-[10px] font-semibold">
                      <div className="bg-blue-600 text-white p-1.5 rounded-lg font-bold shadow-sm">1 시뮬레이션</div>
                      <div className="bg-slate-800 text-slate-300 p-1.5 rounded-lg">2 경영진 검토</div>
                      <div className="bg-slate-800 text-slate-300 p-1.5 rounded-lg">3 RM 승인</div>
                      <div className="bg-slate-800 text-slate-300 p-1.5 rounded-lg">4 전체 적용</div>
                    </div>
                  </div>

                  <button onClick={handleApplySimulatedChanges} className="mt-5 w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3 rounded-xl text-xs sm:text-sm shadow-lg transition-all flex items-center justify-center gap-2">
                    시뮬레이션 결과 즉시 반영하기
                  </button>
                </div>

              </div>

              {/* 최하단 그리드: 경쟁호텔 가격 비교 & 채널별 수익성 비교 & 수요 신호 */}
              <div className="grid grid-cols-12 gap-5 pb-6">
                
                {/* 1. 경쟁호텔 가격 비교 (Comp Set) */}
                <div className="col-span-5 bg-slate-900 rounded-2xl border border-slate-800 p-6 shadow-xl">
                  <div className="flex justify-between items-center mb-4">
                    <h3 className="font-bold text-white text-sm flex items-center gap-2"><Building2 size={16} className="text-amber-400"/> 경쟁호텔 가격 비교 (Comp Set)</h3>
                    <span className="text-xs text-slate-400 font-medium">상권 실시간 크롤링</span>
                  </div>
                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-xs sm:text-sm">
                      <thead>
                        <tr className="border-b border-slate-800 text-slate-400 font-semibold text-xs">
                          <th className="pb-3">호텔명</th>
                          <th className="pb-3">10/09</th>
                          <th className="pb-3">평균가</th>
                          <th className="pb-3">10/10</th>
                          <th className="pb-3">평균가</th>
                          <th className="pb-3 text-right">포지션</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-800/60 font-medium">
                        {compSetData.map((row, idx) => (
                          <tr key={idx} className={row.isMe ? 'bg-amber-500/15 font-bold text-amber-300' : 'text-slate-300'}>
                            <td className="py-3">{row.hotel}</td>
                            <td className="py-3">{row.d1}</td>
                            <td className="py-3 text-slate-400">{row.avg1}</td>
                            <td className="py-3">{row.d2}</td>
                            <td className="py-3 text-slate-400">{row.avg2}</td>
                            <td className="py-3 text-right font-bold text-emerald-400">{row.pos}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

                {/* 2. 채널별 수익성 비교 */}
                <div className="col-span-4 bg-slate-900 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col justify-between">
                  <div>
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="font-bold text-white text-sm flex items-center gap-2"><Globe size={16} className="text-blue-400"/> 채널별 수익성 비교</h3>
                      <span className="text-xs text-slate-400 font-medium">수수료 정산</span>
                    </div>
                    <div className="overflow-x-auto mb-4">
                      <table className="w-full text-left text-xs sm:text-sm">
                        <thead>
                          <tr className="border-b border-slate-800 text-slate-400 font-semibold text-xs">
                            <th className="pb-3">채널명</th>
                            <th className="pb-3">판매가</th>
                            <th className="pb-3">수수료</th>
                            <th className="pb-3 text-right">실수익</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-slate-800/60 font-medium">
                          {channelData.map((ch, idx) => (
                            <tr key={idx} className="text-slate-300">
                              <td className="py-3 font-bold text-white truncate max-w-[130px]">{ch.name}</td>
                              <td className="py-3">{ch.price}</td>
                              <td className="py-3 text-rose-400">{ch.commission}</td>
                              <td className="py-3 text-right font-bold text-emerald-400">{ch.net}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                  <div className="bg-slate-950 p-3.5 rounded-xl border border-slate-800 text-xs text-emerald-400 font-bold flex items-center justify-between shadow-inner">
                    <span className="flex items-center gap-2"><Check size={14}/> Direct 채널 유입 최적화</span>
                    <button onClick={() => showToast('공식 홈페이지 다이렉트 프로모션이 활성화되었습니다.')} className="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1 rounded-lg text-xs font-bold transition-all">전환 촉진</button>
                  </div>
                </div>

                {/* 3. 수요 신호 (Demand Signal) */}
                <div className="col-span-3 bg-slate-900 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col justify-between">
                  <div>
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="font-bold text-white text-sm flex items-center gap-2"><Zap size={16} className="text-amber-400"/> 수요 신호</h3>
                      <span className="text-xs text-blue-400 font-semibold cursor-pointer hover:underline" onClick={() => showToast('모든 실시간 수요 신호가 동기화되었습니다.')}>전체 동기화</span>
                    </div>
                    <div className="space-y-3">
                      {demandSignals.map((sig, idx) => (
                        <div key={idx} className="bg-slate-950 border border-slate-800 p-3 rounded-xl flex justify-between items-center text-xs sm:text-sm">
                          <span className="text-slate-300 font-medium">{sig.label}</span>
                          <span className="font-bold text-emerald-400">{sig.value}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

              </div>

            </div>
          )}

          {/* 타 메뉴 선택 시 렌더링 화면 */}
          {activeMenu !== '대시보드' && (
            <div className="flex-1 bg-slate-900 rounded-2xl border border-slate-800 p-12 flex flex-col items-center justify-center text-center shadow-xl my-auto">
              <Sparkles size={48} className="text-amber-400 mb-4 animate-pulse" />
              <h2 className="text-xl font-bold text-white mb-2">[{activeMenu}] 메뉴 영역</h2>
              <p className="text-sm text-slate-400 mb-6 max-w-md">파르나스호텔 AI 수익관리 시스템과 실시간 연동되어 세부 관리 및 설정을 지원합니다.</p>
              <button onClick={() => setActiveMenu('대시보드')} className="bg-amber-500 hover:bg-amber-400 text-slate-950 px-6 py-3 rounded-xl font-bold text-sm shadow-lg transition-all">대시보드로 돌아가기</button>
            </div>
          )}

        </div>
      </main>
    </div>
  );
}

// 아이콘 헬퍼 컴포넌트
function TagIcon(props: any) {
  return (
    <svg {...props} xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path>
      <path d="M7 7h.01"></path>
    </svg>
  );
}