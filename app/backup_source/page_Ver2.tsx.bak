"use client";

import React, { useState, useEffect, useCallback, useRef } from 'react';
import { LayoutDashboard, Settings, CalendarDays, LineChart as LineChartIcon, Cpu, Bell, ChevronDown, Loader2, PlaneTakeoff, Building2, ShieldAlert, Sliders, Sparkles, X, ExternalLink, Save, CheckCircle2, DollarSign, PieChart, RefreshCcw, Award, Users, Globe, TrendingUp, HelpCircle, ArrowUpRight, Search, Zap, Check } from 'lucide-react';

export default function ParnasPricingDashboard() {
  // 1. 상태 관리
  const [activeMenu, setActiveMenu] = useState('대시보드');
