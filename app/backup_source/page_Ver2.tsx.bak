            <div className="space-y-4 text-xs sm:text-sm">
              <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 flex justify-between items-center">
                <div>
                  <div className="text-slate-400 text-xs">현재 기준가</div>
                  <div className="text-lg font-bold text-slate-300">820,000원</div>
                </div>
                <div className="text-xl font-bold text-slate-500">→</div>
                <div>
