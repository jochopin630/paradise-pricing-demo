                <div className="bg-slate-950 border border-slate-800 p-3.5 rounded-xl text-center"><div className="text-slate-400 text-xs mb-1">식음 (F&B)</div><div className="font-bold text-white text-sm">28.2M</div></div>
                <div className="bg-slate-950 border border-slate-800 p-3.5 rounded-xl text-center"><div className="text-slate-400 text-xs mb-1">연회/MICE</div><div className="font-bold text-white text-sm">11.5M</div></div>
