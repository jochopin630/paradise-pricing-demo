  const menuItems = [
    { icon: <LayoutDashboard size={18} />, label: '대시보드' },
    { icon: <Sliders size={18} />, label: '객실별 가격전략' },
    { icon: <Sparkles size={18} />, label: 'AI 추천 내역' },
    { icon: <LineChartIcon size={18} />, label: '경쟁호텔 분석' },
    { icon: <Globe size={18} />, label: '채널별 수익분석' },
    { icon: <CalendarDays size={18} />, label: '이벤트 & 수요분석' },
