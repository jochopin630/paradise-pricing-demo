              <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 flex justify-between items-center">
                <div><div className="font-bold text-white text-sm">현재 실질 가동률</div><div className="text-xs text-slate-400">총 객실 550실 기준</div></div>
                <div className="text-3xl font-black text-purple-400">76%</div>
              </div>
