  const [lastUpdated, setLastUpdated] = useState('방금 전');
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  // 캘린더 모달 상태 및 동적 날짜 배열
  const [isCalendarOpen, setIsCalendarOpen] = useState(false);
  const [startDate, setStartDate] = useState('2026-10-01');
  const [endDate, setEndDate] = useState('2026-10-14');
  const [dateRangeLabel, setDateRangeLabel] = useState('2026.10.01 (목) ~ 2026.10.14 (수)');
  const [dates, setDates] = useState([
    { day: '10.01', week: '(목)' },
    { day: '10.02', week: '(금)' },
    { day: '10.03', week: '(토)' },
    { day: '10.04', week: '(일)' },
    { day: '10.05', week: '(월)' },
    { day: '10.06', week: '(화)' },
    { day: '10.07', week: '(수)' },
    { day: '10.08', week: '(목)' },
    { day: '10.09', week: '(금)' },
    { day: '10.10', week: '(토)' },
    { day: '10.11', week: '(일)' },
    { day: '10.12', week: '(월)' },
    { day: '10.13', week: '(화)' },
    { day: '10.14', week: '(수)' }
  ]);

  // 마우스 호버 툴팁 상태 및 컨테이너 참조
  const [tooltip, setTooltip] = useState<{ visible: boolean; x: number; y: number; title: string; date: string; price: string } | null>(null);
  const chartContainerRef = useRef<HTMLDivElement>(null);

  // 상단 카드 인터랙티브 팝업 상태 ('none' | 'revenue' | 'occ' | 'competitor' | 'flight' | 'recommendation')
  const [activeModal, setActiveModal] = useState<'none' | 'revenue' | 'occ' | 'competitor' | 'flight' | 'recommendation'>('none');

  // 객실 필터 토글 상태 (Deluxe, Junior, Classic Room, Classic Suite)
  const [roomFilters, setRoomFilters] = useState({
    deluxe: true,
    junior: true,
    classicRoom: true,
    classicSuite: true
  });

  // What-if 시뮬레이션 슬라이더 상태 및 실시간 연산 반영 상태
  const [whatIfSlider, setWhatIfSlider] = useState(15);
  const [simulatedRevenue, setSimulatedRevenue] = useState(138287500);
  const [simulatedAdr, setSimulatedAdr] = useState(1083000);
  const [simulatedOcc, setSimulatedOcc] = useState(76.0);
  const [simulatedRevpar, setSimulatedRevpar] = useState(823000);

  // What-if 슬라이더 조절 시 실시간 지표 연동 함수
  useEffect(() => {
    const factor = 1 + (whatIfSlider / 100) * 0.4;
    const occFactor = Math.max(50, Math.min(95, 76 - (whatIfSlider * 0.15)));
    setSimulatedRevenue(Math.round(138287500 * factor));
    setSimulatedAdr(Math.round(1083000 * factor));
    setSimulatedOcc(Number(occFactor.toFixed(1)));
    setSimulatedRevpar(Math.round(823000 * factor * 0.95));
  }, [whatIfSlider]);

  // 파르나스 객실 타입별 상세 데이터 상태
  const [roomTableData, setRoomTableData] = useState([
    { type: 'Deluxe Room', base: 820000, ai: 945000, final: 945000, change: '+15.2%', occ: '82%', revenue: '+8.6M', color: '#22d3ee', active: true },
    { type: 'Junior Suite', base: 1150000, ai: 1280000, final: 1280000, change: '+11.3%', occ: '68%', revenue: '+5.4M', color: '#f87171', active: true },
    { type: 'Classic Room', base: 680000, ai: 740000, final: 740000, change: '+8.8%', occ: '74%', revenue: '+3.2M', color: '#38bdf8', active: true },
    { type: 'Classic Suite', base: 1320000, ai: 1450000, final: 1450000, change: '+9.8%', occ: '61%', revenue: '+2.8M', color: '#ffffff', active: true }
  ]);

  // 경쟁호텔 가격 비교표 데이터 (Comp Set)
  const compSetData = [
    { hotel: 'PARNAS HOTEL', d1: '945,000원', avg1: '910,000원', d2: '970,000원', avg2: '932,000원', pos: '+3.2%', isMe: true },
    { hotel: 'Hotel A', d1: '920,000원', avg1: '885,000원', d2: '940,000원', avg2: '908,000원', pos: '+2.6%', isMe: false },
    { hotel: 'Hotel B', d1: '970,000원', avg1: '940,000원', d2: '1,020,000원', avg2: '988,000원', pos: '+3.9%', isMe: false },
    { hotel: 'Hotel C', d1: '890,000원', avg1: '860,000원', d2: '930,000원', avg2: '902,000원', pos: '+2.4%', isMe: false },
    { hotel: 'Hotel D', d1: '990,000원', avg1: '960,000원', d2: '1,050,000원', avg2: '1,018,000원', pos: '+4.8%', isMe: false }
  ];

  // 채널별 수익성 비교 데이터
  const channelData = [
    { name: 'Direct (공식 웹/앱)', price: '1,000,000원', commission: '0%', net: '1,000,000원', highlight: true },
    { name: 'OTA (Booking, Expedia 등)', price: '1,000,000원', commission: '18%', net: '820,000원', highlight: false },
    { name: '멤버십 (IHG)', price: '950,000원', commission: '0%', net: '950,000원', highlight: false }
  ];

  // 수요 신호 데이터
  const demandSignals = [
    { label: '예약 Pickup', value: '+23%', trend: 'up' },
    { label: '검색량', value: '+31%', trend: 'up' },
    { label: '경쟁호텔 OCC', value: '+12%', trend: 'up' },
    { label: '지역 이벤트', value: 'O (진행 중)', trend: 'neutral' },
    { label: '과거 동일요일 ADR', value: '+17%', trend: 'up' }
  ];

  const showToast = (msg: string) => {
