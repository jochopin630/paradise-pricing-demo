                <div className="bg-slate-950 border border-slate-800 p-3.5 rounded-xl"><div className="text-slate-400 text-xs mb-1">확정 예약 객실</div><div className="font-bold text-white text-base">418실</div></div>
                <div className="bg-slate-950 border border-slate-800 p-3.5 rounded-xl"><div className="text-slate-400 text-xs mb-1">잔여 가용 객실</div><div className="font-bold text-emerald-400 text-base">132실</div></div>
              </div>
