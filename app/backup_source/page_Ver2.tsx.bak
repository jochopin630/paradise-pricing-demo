  const handleApplyRecommendation = () => {
    setActiveModal('none');
    showToast('AI 추천 가격(Deluxe Room 945,000원)이 승인 대기열에 성공적으로 등록되었습니다!');
  };

  const handleApplySimulatedChanges = () => {
    showToast(`What-if 시뮬레이션 가격 조정률(+${whatIfSlider}%)이 PMS 채널에 적용되었습니다.`);
